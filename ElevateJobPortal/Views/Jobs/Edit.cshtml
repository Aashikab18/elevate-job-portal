@model ElevateJobPortal.ViewModels.JobFormViewModel
@{ ViewData["Title"] = "Edit job"; }

<div class="row justify-content-center">
  <div class="col-md-8">
    <h2 class="mb-3">Edit job</h2>
    <form asp-action="Edit" asp-route-id="@ViewContext.RouteData.Values["id"]" method="post">
      <partial name="_JobForm" model="Model" />
      <button type="submit" class="btn btn-primary">Save changes</button>
      <a asp-action="MyJobs" class="btn btn-secondary">Cancel</a>
    </form>
  </div>
</div>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}