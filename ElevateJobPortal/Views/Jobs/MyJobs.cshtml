@model List<ElevateJobPortal.Models.Job>
@{ ViewData["Title"] = "My jobs"; }

<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>My jobs</h2>
  <a asp-action="Create" class="btn btn-primary">Post a job</a>
</div>

@if (TempData["Message"] != null)
{
  <div class="alert alert-success">@TempData["Message"]</div>
}

@if (!Model.Any())
{
  <p>You have not posted any jobs yet.</p>
}
else
{
  <table class="table table-striped">
    <thead>
      <tr><th>Title</th><th>Location</th><th>Type</th><th>Deadline</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var job in Model)
    {
      <tr>
        <td>@job.Title</td>
        <td>@job.Location</td>
        <td>@job.JobType</td>
        <td>@job.Deadline.ToString("yyyy-MM-dd")</td>
        <td>
          <a asp-action="Edit" asp-route-id="@job.Id" class="btn btn-sm btn-outline-primary">Edit</a>
          <a asp-action="Delete" asp-route-id="@job.Id" class="btn btn-sm btn-outline-danger">Delete</a>
        </td>
      </tr>
    }
    </tbody>
  </table>
}